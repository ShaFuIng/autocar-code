[Unit]
Description=Save synchronized time and recover late RTC clock resets
After=NetworkManager.service systemd-timesyncd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/orin-clock-guard/clock_guard.py
TimeoutStartSec=50
StateDirectory=orin-clock-guard
RuntimeDirectory=orin-clock-guard
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
