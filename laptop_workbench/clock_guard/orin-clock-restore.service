[Unit]
Description=Restore trusted time after Jetson RTC initialization
After=local-fs.target systemd-timesyncd.service
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/orin-clock-guard/clock_guard.py --boot
TimeoutStartSec=40
StateDirectory=orin-clock-guard
RuntimeDirectory=orin-clock-guard
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME

[Install]
WantedBy=multi-user.target
